# The token server's settings, for Part 3 of the Day 5 lab.
# Make a copy of this file, in this folder, named .env.local, and fill it in.
# There's no VITE_ in front of these names: Vite never reads this file, so nothing here reaches the browser.

PORTAL_URL=
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=

# In a codespace only: your app's address, from the browser tab that shows the app. No slash on the end.
# APP_ORIGIN=
