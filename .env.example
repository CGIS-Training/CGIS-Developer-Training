# The Day 5 lab's settings.
# Make a copy of this file, beside it, named .env.development, and fill it in.
# After changing a value, stop the app (Ctrl + C) and start it again (npm run dev).
# Nothing in this file is secret: every value is copied into the JavaScript the browser downloads.

# Which part of the lab is running: none, apiKey, user, or app
VITE_AUTH_MODE=none

# From your instructor
VITE_PORTAL_URL=
VITE_PRIVATE_LAYER_URL=

# Part 1
VITE_ARCGIS_API_KEY=

# Part 2
VITE_ARCGIS_CLIENT_ID=

# Part 3
VITE_TOKEN_URL=http://localhost:3001
